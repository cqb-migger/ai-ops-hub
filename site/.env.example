# API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Google OAuth (see docs/google-oauth-setup.md).
# Client ID only — it is public and shipped to the browser.
# The client secret must NEVER be added here; it belongs to the API only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ALLOWED_DOMAIN=earlybirdjapan.co.jp
