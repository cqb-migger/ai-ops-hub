DEBUG=True
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ops_hub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_ops_hub
JWT_SECRET_KEY=supersecretjwtkeyforaiopshub1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_AGENT_ITERATIONS=10

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# AWS S3 Settings
AWS_ACCESS_KEY_ID=mock
AWS_SECRET_ACCESS_KEY=mock
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET_NAME=ai-ops-hub-guides
AWS_S3_ENDPOINT_URL=
AWS_S3_TENANT_ID=

# Google OAuth (see docs/google-oauth-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only Google Workspace accounts on this domain may sign in. Leave empty to allow any Google account.
GOOGLE_ALLOWED_DOMAIN=earlybirdjapan.co.jp
